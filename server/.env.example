# Supabase connection strings (from Supabase Dashboard -> Project Settings -> Database)
# Use Transaction pooled URL for DATABASE_URL (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use Direct Session URL for DIRECT_URL (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=4000
JWT_SECRET="your-jwt-secret-here"
ADMIN_EMAIL="admin@church.local"
ADMIN_PASSWORD="changeme123"
